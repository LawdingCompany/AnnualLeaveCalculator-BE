meta {
  name: 연차 일정 수정
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/calendar-events/{{eventId}}
  body: json
  auth: bearer
}

headers {
  X-Platform: {{platform}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "반차",
    "description": "Bruno 수정 테스트",
    "startDatetime": "2026-08-20T09:00:00",
    "endDatetime": "2026-08-20T13:00:00",
    "usedLeaveMinutes": 240,
    "isAllDay": false,
    "isLeaveEvent": true
  }
}
